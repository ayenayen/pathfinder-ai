<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pathfinder AI — Navigasi Karir Berbasis AI</title>
<meta name="description" content="Pathfinder AI mendiagnosis gap CV kamu dan kasih roadmap karir spesifik dalam 60 detik. Gratis untuk 200 early user pertama.">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{--navy:#1A2B5F;--navy-dark:#0F1A3D;--navy-light:#2A3F7F;--blue:#4A90E2;--white:#FFFFFF;--gray:#F4F6FA;--text-muted:#8A9BB8;}
body{font-family:'Outfit',sans-serif;background:var(--white);color:var(--navy);overflow-x:hidden;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 40px;display:flex;justify-content:space-between;align-items:center;background:rgba(26,43,95,0.95);backdrop-filter:blur(12px);}
.nav-logo{color:#fff;font-weight:800;font-size:1.2rem;letter-spacing:-0.5px;}
.nav-logo span{color:var(--blue);}
.nav-cta{background:var(--blue);color:#fff;border:none;padding:10px 22px;border-radius:8px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.9rem;cursor:pointer;transition:all 0.2s;}
.nav-cta:hover{background:#3a7bd5;transform:translateY(-1px);}

/* HERO */
.hero{min-height:100vh;background:linear-gradient(135deg,var(--navy-dark) 0%,var(--navy) 50%,var(--navy-light) 100%);display:flex;align-items:center;justify-content:center;text-align:center;padding:100px 20px 60px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(ellipse at 60% 40%,rgba(74,144,226,0.15) 0%,transparent 60%);pointer-events:none;}
.hero-badge{display:inline-block;background:rgba(74,144,226,0.2);border:1px solid rgba(74,144,226,0.4);color:var(--blue);padding:6px 16px;border-radius:20px;font-size:0.85rem;font-weight:600;margin-bottom:24px;letter-spacing:0.5px;}
.hero h1{font-size:clamp(2rem,5vw,3.8rem);font-weight:900;color:#fff;line-height:1.1;margin-bottom:20px;letter-spacing:-1px;}
.hero h1 span{background:linear-gradient(135deg,var(--blue),#7BB3F0);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-sub{font-size:clamp(1rem,2vw,1.25rem);color:rgba(255,255,255,0.75);max-width:580px;margin:0 auto 40px;line-height:1.6;}
.hero-sub strong{color:#fff;}
.hero-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.btn-primary{background:linear-gradient(135deg,var(--blue),#3a7bd5);color:#fff;border:none;padding:16px 36px;border-radius:12px;font-family:'Outfit',sans-serif;font-weight:700;font-size:1rem;cursor:pointer;transition:all 0.3s;text-decoration:none;display:inline-block;}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(74,144,226,0.4);}
.btn-secondary{background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.3);padding:16px 36px;border-radius:12px;font-family:'Outfit',sans-serif;font-weight:700;font-size:1rem;cursor:pointer;transition:all 0.3s;text-decoration:none;display:inline-block;}
.btn-secondary:hover{border-color:#fff;background:rgba(255,255,255,0.1);}
.hero-stats{display:flex;gap:40px;justify-content:center;margin-top:60px;flex-wrap:wrap;}
.stat{text-align:center;}
.stat-num{font-size:2rem;font-weight:900;color:#fff;}
.stat-label{font-size:0.8rem;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;}

/* BENEFITS */
.benefits{padding:100px 20px;background:var(--gray);}
.section-label{text-align:center;color:var(--blue);font-weight:700;font-size:0.85rem;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;}
.section-title{text-align:center;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;color:var(--navy);margin-bottom:16px;letter-spacing:-0.5px;}
.section-sub{text-align:center;color:var(--text-muted);font-size:1rem;max-width:500px;margin:0 auto 60px;}
.benefits-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;max-width:900px;margin:0 auto;}
.benefit-card{background:#fff;border-radius:20px;padding:36px 32px;box-shadow:0 4px 24px rgba(26,43,95,0.08);border:1px solid rgba(26,43,95,0.06);transition:all 0.3s;position:relative;overflow:hidden;}
.benefit-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),#7BB3F0);}
.benefit-card:hover{transform:translateY(-6px);box-shadow:0 16px 48px rgba(26,43,95,0.14);}
.benefit-icon{font-size:2.5rem;margin-bottom:20px;display:block;}
.benefit-card h3{font-size:1.15rem;font-weight:800;color:var(--navy);margin-bottom:10px;}
.benefit-card p{color:var(--text-muted);font-size:0.95rem;line-height:1.6;}

/* SOCIAL PROOF */
.social-proof{padding:100px 20px;background:var(--navy);text-align:center;}
.social-proof h2{font-size:clamp(2rem,4vw,3rem);font-weight:900;color:#fff;margin-bottom:16px;}
.social-proof h2 span{color:var(--blue);}
.social-proof p{color:rgba(255,255,255,0.6);font-size:1rem;margin-bottom:60px;}
.counter-wrap{display:flex;gap:60px;justify-content:center;flex-wrap:wrap;margin-bottom:60px;}
.counter-item{text-align:center;}
.counter-num{font-size:3.5rem;font-weight:900;color:#fff;line-height:1;}
.counter-num span{color:var(--blue);}
.counter-label{color:rgba(255,255,255,0.5);font-size:0.85rem;margin-top:8px;text-transform:uppercase;letter-spacing:1px;}
.avatars{display:flex;justify-content:center;margin-bottom:16px;}
.avatar{width:48px;height:48px;border-radius:50%;border:3px solid var(--navy);background:linear-gradient(135deg,var(--blue),#7BB3F0);margin-left:-12px;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:0.85rem;}
.avatar:first-child{margin-left:0;}
.proof-text{color:rgba(255,255,255,0.7);font-size:0.95rem;}

/* FORM */
.waitlist{padding:100px 20px;background:#fff;}
.form-wrap{max-width:560px;margin:0 auto;background:linear-gradient(135deg,var(--navy),var(--navy-light));border-radius:24px;padding:48px 40px;box-shadow:0 24px 80px rgba(26,43,95,0.2);}
.form-wrap .section-label{color:var(--blue);}
.form-wrap .section-title{color:#fff;margin-bottom:8px;}
.form-wrap .section-sub{color:rgba(255,255,255,0.6);margin-bottom:32px;}
.form-group{margin-bottom:16px;}
.form-group input,.form-group select{width:100%;padding:14px 18px;border-radius:10px;border:1.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.08);color:#fff;font-family:'Outfit',sans-serif;font-size:1rem;transition:border 0.2s;outline:none;}
.form-group input::placeholder{color:rgba(255,255,255,0.4);}
.form-group select{color:rgba(255,255,255,0.7);}
.form-group select option{color:var(--navy);background:#fff;}
.form-group input:focus,.form-group select:focus{border-color:var(--blue);background:rgba(74,144,226,0.1);}
.btn-submit{width:100%;padding:16px;background:linear-gradient(135deg,var(--blue),#3a7bd5);color:#fff;border:none;border-radius:12px;font-family:'Outfit',sans-serif;font-weight:800;font-size:1.05rem;cursor:pointer;transition:all 0.3s;margin-top:8px;}
.btn-submit:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(74,144,226,0.4);}
.form-note{text-align:center;color:rgba(255,255,255,0.4);font-size:0.8rem;margin-top:16px;}
.success-msg{display:none;text-align:center;padding:20px;background:rgba(74,144,226,0.15);border-radius:12px;color:#fff;font-weight:600;}

/* FOOTER */
footer{background:var(--navy-dark);padding:48px 20px;text-align:center;}
.footer-logo{color:#fff;font-weight:800;font-size:1.3rem;margin-bottom:8px;}
.footer-logo span{color:var(--blue);}
.footer-tagline{color:rgba(255,255,255,0.4);font-size:0.9rem;margin-bottom:32px;}
.footer-links{display:flex;gap:24px;justify-content:center;flex-wrap:wrap;margin-bottom:32px;}
.footer-links a{color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.9rem;transition:color 0.2s;}
.footer-links a:hover{color:#fff;}
.footer-demo{display:inline-flex;align-items:center;gap:8px;background:rgba(74,144,226,0.15);border:1px solid rgba(74,144,226,0.3);color:var(--blue);padding:12px 24px;border-radius:10px;text-decoration:none;font-weight:700;transition:all 0.2s;margin-bottom:32px;}
.footer-demo:hover{background:rgba(74,144,226,0.25);}
.footer-bottom{color:rgba(255,255,255,0.25);font-size:0.8rem;}

/* FLOATING CTA */
.floating-cta{position:fixed;bottom:24px;right:24px;z-index:99;background:linear-gradient(135deg,var(--blue),#3a7bd5);color:#fff;padding:14px 24px;border-radius:50px;font-family:'Outfit',sans-serif;font-weight:700;font-size:0.9rem;text-decoration:none;box-shadow:0 8px 32px rgba(74,144,226,0.4);transition:all 0.3s;display:flex;align-items:center;gap:8px;}
.floating-cta:hover{transform:translateY(-3px);box-shadow:0 16px 48px rgba(74,144,226,0.5);}
.pulse{width:8px;height:8px;background:#fff;border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.5;transform:scale(1.5);}}

/* RESPONSIVE */
@media(max-width:600px){
nav{padding:16px 20px;}
.hero-stats{gap:24px;}
.form-wrap{padding:32px 24px;}
.counter-wrap{gap:32px;}
}

/* ANIMATIONS */
.fade-in{opacity:0;transform:translateY(30px);transition:all 0.7s ease;}
.fade-in.visible{opacity:1;transform:translateY(0);}
</style>
</head>
<body>

