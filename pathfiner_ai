<script>
// Google Apps Script Web App URL — GANTI dengan URL kamu setelah deploy
const APPS_SCRIPT_URL = 'PASTE_YOUR_APPS_SCRIPT_URL_HERE';

// PostHog — GANTI dengan snippet kamu
// !function(t,e){...}  // paste posthog snippet here

function handleSubmit(e){
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  btn.textContent = 'Mendaftar...';
  btn.disabled = true;

  const data = {
    nama: document.getElementById('field-nama').value,
    email: document.getElementById('field-email').value,
    jurusan: document.getElementById('field-jurusan').value,
    masalah: document.getElementById('field-masalah').value,
    timestamp: new Date().toISOString()
  };

  // Track event jika PostHog sudah disetup
  if(typeof posthog !== 'undefined'){
    posthog.capture('waitlist_signup', data);
  }

  if(APPS_SCRIPT_URL === 'PASTE_YOUR_APPS_SCRIPT_URL_HERE'){
    // Demo mode — tampilkan success tanpa kirim data
    showSuccess();
    return;
  }

  fetch(APPS_SCRIPT_URL, {
    method:'POST',
    mode:'no-cors',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(data)
  }).then(()=>showSuccess()).catch(()=>showSuccess());
}

function showSuccess(){
  document.getElementById('signup-form').style.display = 'none';
  document.getElementById('success-msg').style.display = 'block';
}

// Track CTA clicks
document.getElementById('hero-cta-btn').addEventListener('click',function(){
  if(typeof posthog!=='undefined') posthog.capture('cta_click',{location:'hero'});
});
document.getElementById('hero-demo-btn').addEventListener('click',function(){
  if(typeof posthog!=='undefined') posthog.capture('demo_click',{location:'hero'});
});
document.getElementById('footer-demo-btn').addEventListener('click',function(){
  if(typeof posthog!=='undefined') posthog.capture('demo_click',{location:'footer'});
});

// Intersection Observer for fade-in
const observer = new IntersectionObserver((entries)=>{
  entries.forEach(el=>{
    if(el.isIntersecting) el.target.classList.add('visible');
  });
},{threshold:0.15});
document.querySelectorAll('.fade-in').forEach(el=>observer.observe(el));

// Counter animation
function animateCounter(el, target, duration=1500){
  let start=0, step=target/60;
  const timer=setInterval(()=>{
    start+=step;
    if(start>=target){start=target;clearInterval(timer);}
    el.textContent=Math.floor(start);
  }, duration/60);
}
const counterObserver = new IntersectionObserver((entries)=>{
  entries.forEach(el=>{
    if(el.isIntersecting){
      animateCounter(document.getElementById('c1'),100);
      animateCounter(document.getElementById('c2'),20);
      animateCounter(document.getElementById('c3'),15);
      counterObserver.disconnect();
    }
  });
},{threshold:0.3});
counterObserver.observe(document.getElementById('social-section'));

// Hide floating CTA when form visible
const formObserver = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    document.getElementById('floating-btn').style.display = e.isIntersecting ? 'none' : 'flex';
  });
},{threshold:0.2});
formObserver.observe(document.getElementById('waitlist-form'));
</script>
